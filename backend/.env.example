# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Groq API key for the AI stock screener (https://console.groq.com/keys).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Google sign-in: the same client ID as frontend/.env (REACT_APP_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Signs sign-in sessions. Optional locally (a random one is used, so a restart
# signs everyone out); required in production. Any long random string.
# SESSION_SECRET=

# Password for the /phpmyadmin database viewer. Optional locally; in production
# the viewer is off unless this is set.
# DB_ADMIN_PASSWORD=

# PostgreSQL (optional). Without it the app uses the SQLite file at DB_PATH.
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/optiontrading?sslmode=disable
