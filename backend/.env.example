# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Groq API key for the AI stock screener (https://console.groq.com/keys).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL (optional). Without it the app uses the SQLite file at DB_PATH.
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/optiontrading?sslmode=disable
